{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf .git/*)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf ../*)",
      "Bash(rm -fr /)",
      "Bash(rm -fr ~)",
      "Bash(rm -fr .git)",
      "Bash(rm -Rf /)",
      "Bash(rm -Rf ~)",
      "Bash(rm -Rf .git)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease origin master)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push origin master)",
      "Bash(git push origin main)",
      "Bash(git push origin master:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:master)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin +master)",
      "Bash(git push origin +main)",
      "Bash(git push origin :master)",
      "Bash(git push origin :main)",
      "Bash(git push origin --delete master)",
      "Bash(git push origin --delete main)",
      "Bash(git push --delete origin master)",
      "Bash(git push --delete origin main)",
      "Bash(git branch -D master)",
      "Bash(git branch -D main)",
      "Bash(git branch -d master)",
      "Bash(git branch -d main)",
      "Bash(git branch --delete master)",
      "Bash(git branch --delete main)"
    ]
  }
}
